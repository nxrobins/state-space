  "testSource": "\nwindow.__uiDone=false;window.__uiMid=false;\nvoid(async()=>{\n const w=window.crossing,check=(v,m)=>{if(!v)throw new Error(m);},same=(a,b)=>JSON.stringify(a)===JSON.stringify(b),wait=ms=>new Promise(r=>setTimeout(r,ms));\n const initial=await w.snapshot(),file=document.getElementById('file');\n async function upload(content){const dt=new DataTransfer();dt.items.add(new File([content],'state.json',{type:'application/json'}));file.files=dt.files;file.dispatchEvent(new Event('change'));await wait(250);}\n await upload('{bad json');check(same(await w.snapshot(),initial),'Malformed file mutated field');\n await w.step({moveX:256});await upload(JSON.stringify(initial));check(same(await w.snapshot(),initial),'File restore differs');check(document.getElementById('error').hidden,'Successful import left an error visible');\n const {routeInput}=await import('./game.js');for(let t=0;t<145;t++)await w.step(routeInput(w.game));await w.view({yaw:Math.PI/2,pitch:.45});check(w.game.events.some(e=>e.type==='ice-walk'),'No ice walk');\n window.__uiMid=true;await new Promise(resolve=>window.__uiContinue=resolve);\n const tape=w.replayTape(),saved=await w.snapshot(),bad=structuredClone(tape);bad.commands.at(-1).tick++;let rejected=false;try{await w.replay(bad);}catch{rejected=true;}check(rejected&&same(await w.snapshot(),saved),'Bad tape mutated state');check(same(await w.replay(tape),saved),'Replay round trip differs');\n await w.reset();document.getElementById('play').click();await wait(120);document.getElementById('play').click();const paused=await w.snapshot();check(paused.field.tick>0,'Play failed');await wait(60);check(same(await w.snapshot(),paused),'Pause failed');\n document.getElementById('route').click();const deadline=performance.now()+10000;while(w.game.status==='playing'&&performance.now()<deadline)await wait(40);check(w.game.status==='won','UI route did not win');\n await w.reset();const oldField=w.game.field;w.game.field.step=async()=>{throw new Error('Injected frame failure');};document.getElementById('play').click();await wait(200);check(document.getElementById('mode').textContent.includes('ERROR'),'Failure did not pause');\n let exported;const originalClick=HTMLAnchorElement.prototype.click;HTMLAnchorElement.prototype.click=function(){if(this.href.startsWith('blob:'))void fetch(this.href).then(r=>r.json()).then(value=>exported=value);else originalClick.call(this);};\n try{document.getElementById('export').click();for(let n=0;n<100&&!exported;n++)await wait(10);check(same(exported,initial),'Error export lost explicit checkpoint');}finally{HTMLAnchorElement.prototype.click=originalClick;}\n await w.reset();check(w.game.field!==oldField,'Reset did not rebuild device');await w.step({moveX:256});check((await w.snapshot()).field.tick===1,'Recovered step failed');\n const pending=w.runBenchmark();setTimeout(()=>w.cancelBenchmark(),200);const partial=await pending;check(partial.cancelled&&!partial.complete&&partial.warmup.length>0,'Cancellation lost partial samples');\n return{passed:true,fileImportAtomic:true,fileImportExact:true,errorClearedAfterValidImport:true,routeAt145:true,replayRoundTripExact:true,invalidTapeAtomic:true,playPause:true,routeButtonWon:true,frameFailurePaused:true,errorCheckpointExportExact:true,resetRebuiltDevice:true,cancelledMeasurement:partial};\n})().then(result=>{window.__uiResult=result;window.__uiDone=true;},error=>{window.__uiResult={passed:false,error:String(error.stack||error)};window.__uiDone=true;});'started'\n",
