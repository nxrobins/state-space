# Preserve exact source/evidence bytes across checkouts for provenance hashes.
* whitespace=cr-at-eol
/.gitattributes -text
/engine/** -text
/eval/** -text
/tests/** -text
/scripts/** -text
/examples/** -text
/locked/** -text
/web/** -text
/tower-defense-rogue/** -text
/docs/** -text
/*.py -text
/*.md -text
/*.toml -text
/*.lock -text
/*.json -text
/game/src/** -text
/dist/packages/evidence/** -text

# Keep the implementation prominent in GitHub's default review view.
/docs/checkpoints/** linguist-generated=true
/docs/checkpoints/*.md linguist-generated=false
# Preserve captured SDK output verbatim, including command-line whitespace.
/docs/checkpoints/volume-m3/safety/sdk/stdout.txt -whitespace
# Preserve captured M5 logs and the byte-bound frozen material-law source.
/docs/checkpoints/volume-m5/**/supervisor/*.log -whitespace
/engine/experimental/structural-material.ts whitespace=cr-at-eol,-blank-at-eof
/dist/packages/evidence/** linguist-generated=true
/engine/generated/** linguist-generated=true
/engine/_generated_schema.py linguist-generated=true
/engine/kernels/** linguist-generated=true
/web/*.generated.js linguist-generated=true
/web/shaders/** linguist-generated=true
