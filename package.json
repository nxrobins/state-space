{
  "name": "state-space-engine",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/nxrobins/state-space",
  "repository": {
    "type": "git",
    "url": "https://github.com/nxrobins/state-space.git"
  },
  "type": "module",
  "scripts": {
    "lint": "node engine/lint_ts.mjs",
    "pretest": "npm run build:sdk",
    "test": "vitest run --config engine/vitest.config.ts && node --test web/rendering.test.mjs",
    "typecheck": "tsc --noEmit -p engine/tsconfig.json",
    "benchmark:cpu": "npm run build:sdk && node scripts/benchmark_cpu.mjs",
    "build:sdk": "vite build --config engine/vite.sdk.config.ts && tsc -p engine/tsconfig.sdk.json",
    "prepack": "npm run build:sdk"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.72",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/types/index.d.ts",
      "import": "./dist/sdk/state-space.js"
    }
  },
  "files": [
    "dist/sdk",
    "ENGINE_CONTRACT.md",
    "docs/SDK.md",
    "docs/STRUCTURES.md",
    "docs/CAPABILITIES.md",
    "docs/EVOLUTION.md"
  ]
}
