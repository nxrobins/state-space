{
  "name": "state-space-engine",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/nxrobins/state-space",
  "repository": {
    "type": "git",
    "url": "https://github.com/nxrobins/state-space.git"
  },
  "type": "module",
  "scripts": {
    "lint": "node engine/lint_ts.mjs",
    "pretest": "npm run build:sdk",
    "test": "node scripts/verify_checks.mjs",
    "test:native": "node scripts/verify_checks.mjs --suite native",
    "test:demos": "node scripts/verify_checks.mjs --suite demos",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p engine/tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p examples/reactive-chamber/tsconfig.json",
    "benchmark:cpu": "npm run build:sdk && node scripts/benchmark_cpu.mjs",
    "build:sdk": "node scripts/build_sdk.mjs",
    "verify:3d": "npm run build:sdk && node scripts/verify_volume.mjs",
    "benchmark:3d": "npm run build:sdk && node scripts/benchmark_volume.mjs",
    "verify:3d:m2": "npm run build:sdk && node scripts/verify_volume_m2.mjs",
    "prepack": "npm run build:sdk",
    "verify:3d:m3": "npm run build:sdk && node scripts/verify_volume_m3.mjs",
    "verify:3d:m4": "npm run build:sdk && node scripts/verify_volume_m4.mjs",
    "build:tactical-slab": "node scripts/build_tactical_slab.mjs",
    "lab": "uv run python -m scripts.serve_lab",
    "pretest:smoke": "npm run build:sdk",
    "test:smoke": "node scripts/verify_checks.mjs --suite smoke",
    "verify:macos:native": "uv run python -m scripts.verify_macos_native",
    "verify:packages": "uv run python -m scripts.verify_packages",
    "verify:macos": "uv run python -m scripts.verify_macos_qualification",
    "build:reactive-chamber": "node scripts/build_reactive_chamber.mjs",
    "format:check": "prettier --check \"engine/**/*.{ts,mjs}\" \"examples/**/*.{ts,mjs,html,css,json}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format": "prettier --write \"engine/**/*.{ts,mjs}\" \"examples/**/*.{ts,mjs,html,css,json}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "6.0.2",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/types/index.d.ts",
      "import": "./dist/sdk/state-space.js"
    },
    "./experimental/3d/gpu": {
      "types": "./dist/sdk/types/experimental/3d-gpu.d.ts",
      "import": "./dist/sdk/state-space-3d-gpu.js"
    },
    "./experimental/3d": {
      "types": "./dist/sdk/types/experimental/3d.d.ts",
      "import": "./dist/sdk/state-space-3d.js"
    },
    "./experimental/3d/world": {
      "types": "./dist/sdk/types/experimental/world.d.ts",
      "import": "./dist/sdk/state-space-world.js"
    },
    "./experimental/3d/world/gpu": {
      "types": "./dist/sdk/types/experimental/world-gpu.d.ts",
      "import": "./dist/sdk/state-space-world-gpu.js"
    },
    "./experimental/3d/active-world": {
      "types": "./dist/sdk/types/experimental/active-world.d.ts",
      "import": "./dist/sdk/state-space-active-world.js"
    },
    "./experimental/3d/structural-world/gpu": {
      "types": "./dist/sdk/types/experimental/structural-world-gpu.d.ts",
      "import": "./dist/sdk/state-space-structural-world-gpu.js"
    },
    "./experimental/3d/structural-world": {
      "types": "./dist/sdk/types/experimental/structural-world.d.ts",
      "import": "./dist/sdk/state-space-structural-world.js"
    },
    "./experimental/3d/active-world/gpu": {
      "types": "./dist/sdk/types/experimental/active-world-gpu.d.ts",
      "import": "./dist/sdk/state-space-active-world-gpu.js"
    },
    "./experimental/3d/interventions": {
      "types": "./dist/sdk/types/experimental/interventions.d.ts",
      "import": "./dist/sdk/state-space-interventions.js"
    },
    "./experimental/3d/tactical-session": {
      "types": "./dist/sdk/types/experimental/tactical-session.d.ts",
      "import": "./dist/sdk/state-space-tactical-session.js"
    },
    "./experimental/3d/tactical-renderer": {
      "types": "./dist/sdk/types/experimental/tactical-renderer.d.ts",
      "import": "./dist/sdk/state-space-tactical-renderer.js"
    },
    "./experimental/3d/reactive-materials": {
      "types": "./dist/sdk/types/experimental/reactive-materials.d.ts",
      "import": "./dist/sdk/state-space-reactive-materials.js"
    },
    "./experimental/3d/multiphysics": {
      "types": "./dist/sdk/types/experimental/multiphysics.d.ts",
      "import": "./dist/sdk/state-space-multiphysics.js"
    },
    "./experimental/3d/rock-textures": {
      "types": "./dist/sdk/types/experimental/rock-textures.d.ts",
      "import": "./dist/sdk/state-space-rock-textures.js"
    }
  },
  "files": [
    "dist/sdk",
    "ENGINE_CONTRACT.md",
    "docs/SDK.md",
    "docs/sdk",
    "docs/VALIDATION_STATUS.md",
    "docs/ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "docs/THIRD_PARTY.md",
    "engine/experimental/ROCK_TEXTURES.md",
    "docs/STRUCTURES.md",
    "docs/PRESSURE.md",
    "docs/CAPABILITIES.md",
    "docs/EVOLUTION.md",
    "docs/checkpoints/3D_M1.md",
    "docs/checkpoints/3D_M2.md",
    "docs/checkpoints/3D_M3.md",
    "docs/checkpoints/3D_M4.md",
    "docs/checkpoints/3D_M5.md",
    "docs/checkpoints/CAVERN_MATERIALS.md",
    "docs/checkpoints/CAVERN_OPTICS.md",
    "docs/checkpoints/CAVERN_HAZE.md",
    "docs/checkpoints/CAVERN_HEAT.md",
    "docs/checkpoints/TACTICAL_INTERVENTIONS.md",
    "docs/MULTIPHYSICS.md"
  ],
  "dependencies": {
    "@typescript/lib-dom": "npm:@types/web@0.0.359"
  }
}
